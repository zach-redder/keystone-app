{
  "expo": {
    "name": "Keystone",
    "slug": "keystone",
    "scheme": "keystone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/keystone.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/keystone.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddermedia.keystone",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.reddermedia.keystone",
            "CFBundleURLSchemes": [
              "keystone"
            ]
          },
          {
            "CFBundleURLName": "com.reddermedia.keystone",
            "CFBundleURLSchemes": [
              "keystone"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.reddermedia.keystone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/keystone.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "keystone"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/keystone.png"
    },
    "extra": {
      "eas": {
        "projectId": "dcae90a0-8eb4-4fe0-b8d0-e50c0989c2e3"
      }
    },
    "owner": "zach_redder"
  }
}
