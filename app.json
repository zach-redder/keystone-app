{
  "expo": {
    "name": "Keystone",
    "slug": "keystone",
    "scheme": "keystone",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/keystone.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logos/keystone.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddermedia.keystone",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:thekeystoneapp.com"
      ],
